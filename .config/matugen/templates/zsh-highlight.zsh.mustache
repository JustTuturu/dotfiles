# Matugen-generated zsh-syntax-highlighting theme - Optimized for blur contrast
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main cursor)
typeset -gA ZSH_HIGHLIGHT_STYLES

ZSH_HIGHLIGHT_STYLES[default]="fg={{colors.on_surface.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[unknown-token]="fg={{colors.error.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[reserved-word]="fg={{colors.primary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[alias]="fg={{colors.tertiary_fixed.default.hex}},bold,italic"
ZSH_HIGHLIGHT_STYLES[suffix-alias]="fg={{colors.tertiary_fixed.default.hex}},bold,italic"
ZSH_HIGHLIGHT_STYLES[global-alias]="fg={{colors.tertiary_fixed.default.hex}},bold,italic"
ZSH_HIGHLIGHT_STYLES[builtin]="fg={{colors.tertiary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[function]="fg={{colors.tertiary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[command]="fg={{colors.tertiary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[precommand]="fg={{colors.secondary_fixed.default.hex}},bold,italic"
ZSH_HIGHLIGHT_STYLES[hashed-command]="fg={{colors.tertiary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[autodirectory]="fg={{colors.primary_fixed.default.hex}},bold,italic"

ZSH_HIGHLIGHT_STYLES[single-hyphen-option]="fg={{colors.secondary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[double-hyphen-option]="fg={{colors.secondary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[back-quoted-argument]="fg={{colors.primary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[single-quoted-argument]="fg={{colors.secondary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[double-quoted-argument]="fg={{colors.secondary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument]="fg={{colors.primary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[assign]="fg={{colors.on_surface.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[named-fd]="fg={{colors.on_surface.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[numeric-fd]="fg={{colors.on_surface.default.hex}},bold"

ZSH_HIGHLIGHT_STYLES[commandseparator]="fg={{colors.error.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[redirection]="fg={{colors.primary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[path]="fg={{colors.primary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[path_pathseparator]="fg={{colors.secondary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[path_prefix]="fg={{colors.primary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[path_prefix_pathseparator]="fg={{colors.secondary_fixed.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[globbing]="fg={{colors.secondary_fixed.default.hex}},bold"
ZSH_HIGHLIGHT_STYLES[history-expansion]="fg={{colors.primary_fixed.default.hex}},bold,underline"

ZSH_HIGHLIGHT_STYLES[comment]="fg={{colors.on_surface_variant.default.hex}},italic"
ZSH_HIGHLIGHT_STYLES[cursor]="fg={{colors.on_surface.default.hex}},bold"

ZSH_HIGHLIGHT_STYLES[single-quoted-argument-unclosed]="fg={{colors.error.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[double-quoted-argument-unclosed]="fg={{colors.error.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[dollar-quoted-argument-unclosed]="fg={{colors.error.default.hex}},bold,underline"
ZSH_HIGHLIGHT_STYLES[back-quoted-argument-unclosed]="fg={{colors.error.default.hex}},bold,underline"
