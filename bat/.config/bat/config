# ─── Bat Config ──────────────────────────────────────────────────
# Theme dynamically generated by matugen (~/.config/bat/themes/matugen.tmTheme)

--theme="matugen"

# Show line numbers, git changes, file header, and separator rule
--style=numbers,changes,header,rule

# Never auto-page (use shell scrollback or pipe to less manually)
--paging=auto

# Wrap long lines
--wrap="auto"

# Number of context lines to show for diffs
--diff-context=3

# Use 2-space tabs for consistent alignment
--tabs=2

# Enable italic for comments/docstrings (JetBrainsMono NF supports italics)
--italic-text=always

# Map custom extensions to known syntaxes
--map-syntax .ignore:.gitignore
--map-syntax .fdignore:.gitignore
--map-syntax .dockerignore:.gitignore
