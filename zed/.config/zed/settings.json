// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed

{
  "language_models": {
    "opencode": {
      "show_zen_models": true
    }
  },
  "proxy": "",
  "context_servers": {

  },
  "debugger": {
    "dock": "left"
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 20.0,
    "button": false
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },

  // UI / buffer fonts
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 16,
  "buffer_font_size": 15,

  // Buffer interaction
  "autosave": "on_focus_change",

  // Inline diagnostics (error lens)
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null,
    },

  },

  // Toolbar / panel buttons in the status bar
  "collaboration_panel": {
    "button": false,
  },

  "project_panel": {
    "dock": "left",
  },

  // CLI opening behavior
  "cli_default_open_behavior": "existing_window",

  // Map file extensions to Zed languages
  "file_types": {
    "INI": [],
    "JavaScript": ["*.qml"],
    "JSON": ["*.jsonc", "*.json.mustache"],
    "Shell Script": ["*.conf", ".zshrc", "*.zsh.mustache", "config","config.ghostty"],
    "TOML": ["*.toml.mustache"],
    "XML": ["*.tmTheme.mustache", "fonts.conf"],
    "YAML": ["*.yml.mustache"],
  },

  // Python language servers
  "languages": {
    "Lua": {
      "language_servers": [
        "lua-language-server",
      ],
    },
    "Python": {
      "language_servers": [
        "basedpyright",
        "ruff",
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
  },
  "lsp": {
    "lua-language-server": {
      "settings": {
        "Lua": {
          "diagnostics": {
            "globals": ["hl"],
          },
        },
      },
    },
    "basedpyright": {
      "binary": {
        "path": "basedpyright-langserver",
        "arguments": ["--stdio"],
      },
      "settings": {
        "python": {
          "analysis": {
            "typeCheckingMode": "standard",
            "useLibraryCodeForTypes": true,
          },
        },
      },
    },
    "ruff": {
      "binary": {
        "path": "ruff",
        "arguments": ["server"],
      },
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
              }
            },
        "less": {
          "lint": {
            "unknownAtRules": "ignore"
              }
            },
        "scss": {
          "lint": {
            "unknownAtRules": "ignore"
          },
        },
      },
    },
  },

  // Agent
  "agent_servers": {
    "opencode": {
      "default_config_options": {
        "model": "opencode/nemotron-3-ultra-free"
      },
      "type": "registry",
    },
    "codex-acp": {
      "type": "registry",
    },
  },

  "agent": {
    "tool_permissions": {
      "default": "confirm",
      "tools": {}
    },
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
    "default_model": {
      "provider": "GLM 5.1",
      "model": "glm-5.1",
      "enable_thinking": false,
    },
  },

  // Remote connections (~/.ssh + host alias `sv`)
  "ssh_connections": [
    {
      "host": "sv",
      "args": [],
      "projects": [
        {
          "paths": ["/home/suzu"],
        },
      ],
    },
  ],
}
