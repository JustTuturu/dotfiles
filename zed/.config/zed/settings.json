// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed

{
  "language_models": {
    "opencode": {
      "show_go_models": true,
      "show_zen_models": false
    }
  },
  "proxy": "",
  "context_servers": {

  },
  "debugger": {
    "dock": "left"
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font Mono",
    "font_size": 20.0,
    "button": false
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha",
  },

  // UI / buffer fonts
  "icon_theme": "Catppuccin Mocha",
  "ui_font_size": 16,
  "buffer_font_size": 15,

  // Buffer interaction
  "autosave": "on_focus_change",

  // Inline diagnostics (error lens)
  "diagnostics": {
    "inline": {
      "enabled": true,
      "max_severity": null,
    },

  },

  // Toolbar / panel buttons in the status bar
  "collaboration_panel": {
    "button": false,
  },

  "project_panel": {
    "dock": "left",
  },

  // CLI opening behavior
  "cli_default_open_behavior": "existing_window",

  // Map file extensions to Zed languages
  "file_types": {
    "INI": [],
    "JavaScript": ["*.qml"],
    "JSON": ["*.jsonc", "*.json.mustache"],
    "Shell Script": ["*.conf", ".zshrc", "*.zsh.mustache", "config","config.ghostty"],
    "TOML": ["*.toml.mustache"],
    "XML": ["*.tmTheme.mustache", "fonts.conf"],
    "YAML": ["*.yml.mustache"],
  },

  // Python language servers
  "languages": {
    "Lua": {
      "language_servers": [
        "lua-language-server",
      ],
    },
    "Python": {
      "language_servers": [
        "basedpyright",
        "ruff",
      ],
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
    },
    "Typst": {
          "soft_wrap": "none",
    },
  },
  "lsp": {
    "tinymist": {
      "initialization_options": {
        "preview": {
          "background": {
            "enabled": true
          },
        },
      },
      "settings": {
        "exportPdf": "onSave",
        "outputPath": "$root/$dir/$name",
        "formatterMode": "typstyle",
      },
    },
    "lua-language-server": {
      "settings": {
        "Lua": {
          "diagnostics": {
            "globals": ["hl"],
          },
        },
      },
    },
    "ruff": {
      "binary": {
        "path": "ruff",
        "arguments": ["server"],
      },
    },
    "vscode-css-language-server": {
      "settings": {
        "css": {
          "lint": {
            "unknownAtRules": "ignore"
              }
            },
        "less": {
          "lint": {
            "unknownAtRules": "ignore"
              }
            },
        "scss": {
          "lint": {
            "unknownAtRules": "ignore"
          },
        },
      },
    },
  },

  // Agent
  "agent_servers": {
    "opencode": {
      "type": "registry"
    },
  },

  "agent": {
    "profiles": {

    },
    "terminal_init_command": "codex --profile openrouter",
    "tool_permissions": {
      "default": "confirm",
      "tools": {}
    },
    "dock": "right",
    "sidebar_side": "right",
    "favorite_models": [],
    "model_parameters": [],
    "default_model": {
      "effort": "medium",
      "provider": "zed.dev",
      "model": "gpt-5.6-luna",
      "enable_thinking": true,
    },
  },

  // Remote connections (~/.ssh + host alias `sv`)
  "ssh_connections": [
    {
      "host": "sv",
      "args": [],
      "projects": [
        {
          "paths": ["/home/suzu"],
        },
      ],
    },
  ],
}
