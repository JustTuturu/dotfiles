<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>name</key>
    <string>Matugen</string>
    <key>settings</key>
    <array>
        <!-- Global settings -->
        <dict>
            <key>settings</key>
            <dict>
                <key>background</key>
                <string>{{colors.surface.default.hex}}</string>
                <key>foreground</key>
                <string>{{colors.on_surface.default.hex}}</string>
                <key>caret</key>
                <string>{{colors.inverse_primary.default.hex}}</string>
                <key>selection</key>
                <string>{{colors.primary_container.default.hex}}</string>
                <key>selectionForeground</key>
                <string>{{colors.on_primary_container.default.hex}}</string>
                <key>lineHighlight</key>
                <string>{{colors.surface_container_high.default.hex}}</string>
                <key>invisibles</key>
                <string>{{colors.surface_container_highest.default.hex}}</string>
                <key>guide</key>
                <string>{{colors.surface_container_highest.default.hex}}</string>
            </dict>
        </dict>

        <!-- Comment -->
        <dict>
            <key>name</key>
            <string>Comment</string>
            <key>scope</key>
            <string>comment, punctuation.definition.comment</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.outline.default.hex}}</string>
                <key>fontStyle</key>
                <string>italic</string>
            </dict>
        </dict>

        <!-- Keyword / Storage -->
        <dict>
            <key>name</key>
            <string>Keyword</string>
            <key>scope</key>
            <string>keyword, storage.type, storage.modifier</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.inverse_primary.default.hex}}</string>
                <key>fontStyle</key>
                <string>bold</string>
            </dict>
        </dict>

        <!-- String -->
        <dict>
            <key>name</key>
            <string>String</string>
            <key>scope</key>
            <string>string, punctuation.definition.string</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_secondary_container.default.hex}}</string>
            </dict>
        </dict>

        <!-- Number / Constant -->
        <dict>
            <key>name</key>
            <string>Number, Constant</string>
            <key>scope</key>
            <string>constant.numeric, constant.language, constant.character, constant.other</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_tertiary_container.default.hex}}</string>
            </dict>
        </dict>

        <!-- Function -->
        <dict>
            <key>name</key>
            <string>Function</string>
            <key>scope</key>
            <string>entity.name.function, support.function</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.primary.default.hex}}</string>
                <key>fontStyle</key>
                <string>bold</string>
            </dict>
        </dict>

        <!-- Variable -->
        <dict>
            <key>name</key>
            <string>Variable</string>
            <key>scope</key>
            <string>variable, entity.name.variable, support.variable</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_surface.default.hex}}</string>
            </dict>
        </dict>

        <!-- Type / Class -->
        <dict>
            <key>name</key>
            <string>Type, Class</string>
            <key>scope</key>
            <string>entity.name.type, support.type, entity.name.class, support.class</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.tertiary.default.hex}}</string>
                <key>fontStyle</key>
                <string>bold</string>
            </dict>
        </dict>

        <!-- Operator / Punctuation -->
        <dict>
            <key>name</key>
            <string>Operator</string>
            <key>scope</key>
            <string>keyword.operator, punctuation.definition.operator</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_surface_variant.default.hex}}</string>
            </dict>
        </dict>

        <!-- Brackets / Delimiters -->
        <dict>
            <key>name</key>
            <string>Brackets</string>
            <key>scope</key>
            <string>punctuation.section.brackets, punctuation.section.parens, punctuation.section.braces</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_surface_variant.default.hex}}</string>
            </dict>
        </dict>

        <!-- Tag (HTML/XML) -->
        <dict>
            <key>name</key>
            <string>Tag</string>
            <key>scope</key>
            <string>entity.name.tag, punctuation.definition.tag</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.inverse_primary.default.hex}}</string>
                <key>fontStyle</key>
                <string>bold</string>
            </dict>
        </dict>

        <!-- Attribute (HTML/XML) -->
        <dict>
            <key>name</key>
            <string>Attribute</string>
            <key>scope</key>
            <string>entity.other.attribute-name</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.secondary.default.hex}}</string>
            </dict>
        </dict>

        <!-- Invalid / Error -->
        <dict>
            <key>name</key>
            <string>Invalid</string>
            <key>scope</key>
            <string>invalid, invalid.illegal</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.error.default.hex}}</string>
                <key>background</key>
                <string>{{colors.error_container.default.hex}}</string>
                <key>fontStyle</key>
                <string>bold underline</string>
            </dict>
        </dict>

        <!-- Diff Inserted -->
        <dict>
            <key>name</key>
            <string>Diff Inserted</string>
            <key>scope</key>
            <string>markup.inserted, meta.diff.header.to-file</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.tertiary.default.hex}}</string>
            </dict>
        </dict>

        <!-- Diff Deleted -->
        <dict>
            <key>name</key>
            <string>Diff Deleted</string>
            <key>scope</key>
            <string>markup.deleted, meta.diff.header.from-file</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.error.default.hex}}</string>
            </dict>
        </dict>

        <!-- Diff Changed -->
        <dict>
            <key>name</key>
            <string>Diff Changed</string>
            <key>scope</key>
            <string>markup.changed</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.inverse_primary.default.hex}}</string>
            </dict>
        </dict>

        <!-- Parameters / Arguments -->
        <dict>
            <key>name</key>
            <string>Parameter</string>
            <key>scope</key>
            <string>variable.parameter</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_surface.default.hex}}</string>
                <key>fontStyle</key>
                <string>italic</string>
            </dict>
        </dict>

        <!-- Built-in / Library -->
        <dict>
            <key>name</key>
            <string>Built-in constant</string>
            <key>scope</key>
            <string>constant.language, support.constant</string>
            <key>settings</key>
            <dict>
                <key>foreground</key>
                <string>{{colors.on_tertiary_container.default.hex}}</string>
                <key>fontStyle</key>
                <string>bold</string>
            </dict>
        </dict>
    </array>
    <key>uuid</key>
    <string>matugen-bat-theme-v2</string>
</dict>
</plist>
